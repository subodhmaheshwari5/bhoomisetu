# Used by docker-compose.yml. Copy to .env before running `docker compose up`.

DB_PASSWORD=bhoomisetu_dev

# Required — generate your own, e.g.: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# The origin the frontend is served from. Only matters if you access the
# API directly (bypassing the frontend's nginx proxy); the containerized
# frontend itself talks to the backend same-origin via /api.
CORS_ORIGIN=http://localhost:8080
