# Test environment. Loaded explicitly by `npm run prepare:test` and `npm test`
# via node's --env-file flag, so it is applied before any application code runs
# and the dotenv .env load cannot override it.
#
#   npm test -> pretest -> prepare:test -> isolate -> migrate -> seed
NODE_ENV=test

# How the test run is isolated. The seed truncates and rewrites every domain
# table, so the run must never touch the development schema.
#
# Default: a dedicated SCHEMA on the configured server. This needs no superuser
# rights, and prepareTest.ts refuses to run unless the name contains "test".
TEST_DB_SCHEMA=bhoomisetu_test

# Optional upgrade to a fully separate database. Enable this only once the
# database exists, creating it once as a superuser:
#
#   psql -U postgres -d postgres -c "CREATE DATABASE bhoomisetu_test OWNER bhoomisetu;"
#
# When set, prepareTest.ts uses it and creates it automatically if the role has
# CREATEDB. It still refuses any name that does not contain "test".
# TEST_DATABASE_URL=postgresql://bhoomisetu:bhoomisetu_dev@localhost:5432/bhoomisetu_test

# Required by config/env.ts. Only used to sign test tokens.
JWT_SECRET=test-only-secret-not-used-anywhere-else