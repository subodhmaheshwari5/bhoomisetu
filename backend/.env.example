NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Requires the PostGIS extension enabled on this database
# (the migration runs `CREATE EXTENSION IF NOT EXISTS postgis;` for you).
DATABASE_URL=postgresql://bhoomisetu:bhoomisetu_dev@localhost:5432/bhoomisetu

# Dedicated throwaway database used only by `npm test`. It is configured in
# .env.test, which the test scripts load via node's --env-file flag. It MUST be a
# separate database: the test seed truncates and rewrites every domain table, and
# prepareTest.ts aborts unless the database name contains "test".
TEST_DATABASE_URL=postgresql://bhoomisetu:bhoomisetu_dev@localhost:5432/bhoomisetu_test

# Generate your own for anything beyond local development, e.g.: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Must match the frontend's dev server origin so the browser can call this API.
CORS_ORIGIN=http://localhost:5173
